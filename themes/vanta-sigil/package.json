{
	"name": "vanta-sigil",
	"displayName": "VANTA Sigil",
	"description": "Cópia local do Lynx Theme Pro (MIT), recosmetizada na paleta preta/vermelha VANTA. Não depende da loja.",
	"version": "1.0.0",
	"publisher": "computador",
	"license": "MIT",
	"engines": {
		"vscode": "^1.75.0"
	},
	"categories": [
		"Themes",
		"Other"
	],
	"keywords": [
		"theme",
		"color theme",
		"dark theme",
		"light theme",
		"icon theme",
		"icons",
		"file icons",
		"syntax highlighting",
		"dark mode",
		"light mode",
		"minimal",
		"productivity",
		"eye strain",
		"liquid",
		"glassmorphism",
		"cursor",
		"windsurf",
		"lynx"
	],
	"icon": "icon.png",
	"galleryBanner": {
		"color": "#0a0a0a",
		"theme": "dark"
	},
	"homepage": "",
	"repository": {
		"type": "git",
		"url": ""
	},
	"author": {
		"name": "Computador",
		"note": "Fork local do Lynx Theme Pro (MIT, bastndev)"
	},
	"l10n": "./l10n",
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./dist/themes/liquid-theme/liquid-theme.js",
	"contributes": {
		"themes": [
			{
				"label": "VANTAㅤㅤ(Sigil Theme)",
				"uiTheme": "vs-dark",
				"path": "./src/themes/09_Vanta-Sigil-theme.json"
			},
			{
				"label": "1. DARKㅤㅤ(Lynx Theme)",
				"uiTheme": "vs-dark",
				"path": "./src/themes/01_Lynx-Dark-theme.json"
			},
			{
				"label": "2. LIGHT ㅤ (Lynx Theme)",
				"uiTheme": "vs",
				"path": "./src/themes/02_Lynx-Light-theme.json"
			},
			{
				"label": "3. NIGHT ㅤ(Lynx Theme)",
				"uiTheme": "vs-dark",
				"path": "./src/themes/03_Lynx-Night-theme.json"
			},
			{
				"label": "4. GHIBLI ㅤ(Lynx Theme)",
				"uiTheme": "vs",
				"path": "./src/themes/04_Lynx-Ghibli-theme.json"
			},
			{
				"label": "5. FURY ㅤ (Lynx Theme)",
				"uiTheme": "vs-dark",
				"path": "./src/themes/05_Lynx-Fury-theme.json"
			},
			{
				"label": "6. KIROㅤㅤ(Lynx Theme)",
				"uiTheme": "vs-dark",
				"path": "./src/themes/06_Lynx-Kiro-theme.json"
			},
			{
				"label": "7. NVIMㅤㅤ(Lynx Theme)",
				"uiTheme": "vs-dark",
				"path": "./src/themes/07_Lynx-NVIM-theme.json"
			},
			{
				"label": "8. LIQUIDㅤㅤ(Lynx Theme) 🧪",
				"uiTheme": "vs-dark",
				"path": "./src/themes/08_Lynx-Liquid-theme.json"
			}
		],
		"iconThemes": [
			{
				"id": "vanta-pro-dark",
				"label": "VANTA Icons - (Style A)",
				"path": "./src/icons/icon-themes/lynx-icons-dark.json"
			},
			{
				"id": "vanta-pro-light",
				"label": "VANTA Icons - (Style B)",
				"path": "./src/icons/icon-themes/lynx-icons-light.json"
			},
			{
				"id": "vanta-pro-gray",
				"label": "VANTA Icons - (Style C)",
				"path": "./src/icons/icon-themes/lynx-icons-gray.json"
			}
		],
		"productIconThemes": [
			{
				"id": "vanta-test-icons",
				"label": "VANTA (Test) Icons",
				"path": "./src/icons/icon-system/lynx-test-icon.json"
			},
			{
				"id": "vanta-material-icons",
				"label": "VANTA (Material) Icons",
				"path": "./src/icons/icon-system/lynx-material-icon.json"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "bun run package",
		"compile": "node esbuild.js",
		"watch": "node esbuild.js --watch",
		"package": "node esbuild.js --production",
		"lint": "eslint .",
		"check-types": "tsc --noEmit"
	},
	"devDependencies": {
		"@eslint/js": "^9.21.0",
		"@types/node": "^25.6.0",
		"@types/vscode": "^1.75.0",
		"esbuild": "^0.25.0",
		"eslint": "^9.21.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.25.0"
	}
}
